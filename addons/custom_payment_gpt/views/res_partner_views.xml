<odoo>
    <record id="view_partner_form_inherit_partial_payment" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.partial.payment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']" position="inside">
                <field name="x_allow_partial_portal_payment"/>
            </xpath>
        </field>
    </record>
</odoo>