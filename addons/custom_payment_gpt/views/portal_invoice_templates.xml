<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template
        id="portal_invoice_custom_amount"
        inherit_id="account.portal_invoice_page"
    >

        <xpath expr="//div[@id='total']" position="before">

            <t t-if="invoice.partner_id.allow_custom_portal_amount and invoice.amount_residual > 0">

                <div class="card mb-3">

                    <div class="card-body">

                        <form
                            t-att-action="'/my/invoices/%s/custom_pay' % invoice.id"
                            method="post"
                        >

                            <input
                                type="hidden"
                                name="csrf_token"
                                t-att-value="request.csrf_token()"
                            />

                            <h5 class="mb-3">
                                Pago personalizado
                            </h5>

                            <div class="mb-3">

                                <label class="form-label">
                                    Monto a pagar
                                </label>

                                <input
                                    type="number"
                                    name="custom_amount"
                                    step="0.01"
                                    min="1"
                                    t-att-max="invoice.amount_residual"
                                    t-att-value="invoice.amount_residual"
                                    class="form-control"
                                    required="required"
                                />

                            </div>

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                Continuar al pago
                            </button>

                        </form>

                    </div>

                </div>

            </t>

        </xpath>

    </template>

</odoo>