<template id="portal_invoice_custom_amount" inherit_id="account.portal_invoice_page">
    <!-- Cambiamos //article por el ID específico de Odoo 18 para el área de pago -->
    <xpath expr="//div[@id='invoice_pay']" position="before">
        <t t-if="invoice.amount_residual > 0">
            <div class="mb-3 p-3 border rounded bg-light">
                <label for="amount" class="form-label font-weight-bold">Monto personalizado a abonar:</label>
                <div class="input-group">
                    <span class="input-group-text" t-esc="invoice.currency_id.symbol"/>
                    <!-- Este input debe tener el nombre 'amount' para que el controlador lo reciba -->
                    <input type="number" 
                           name="amount" 
                           id="custom_payment_amount"
                           step="0.01"
                           t-att-value="invoice.amount_residual"
                           t-att-max="invoice.amount_residual"
                           class="form-control"
                           title="Indique el monto que desea pagar"/>
                </div>
                <small class="text-muted">El saldo pendiente actual es: <t t-esc="invoice.amount_residual" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/></small>
            </div>
        </t>
    </xpath>
</template>