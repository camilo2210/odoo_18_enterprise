<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =================================================================
             TEMPLATE 1: /helpdesk/teams — Selector de equipos multicompañía
             ================================================================= -->
        <template id="helpdesk_teams_page" name="Mesa de Ayuda — Equipos">
            <t t-call="website.layout">
                <div class="container">
                    <div class="col-md px-0 team_list_columns">
                        
                        <div class="row">
                            <div class="col-12 text-center">
                                <h1 class="o_page_header mb32 mt32">Seleccione su equipo para ayuda</h1>
                                <p class="text-muted" t-if="not is_public">
                                    Mostrando equipos de sus compañías autorizadas
                                </p>
                            </div>
                        </div>

                        <!-- Bucle por compañías para agrupar los equipos -->
                        <t t-if="teams">
                            <t t-foreach="companies" t-as="company">
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <h3 class="mb-3"><t t-esc="company.name"/></h3>
                                    </div>
                                    <div t-foreach="teams.filtered(lambda t: t.company_id.id == company.id)" t-as="team" class="col-md-6 col-lg-4 mb-4">
                                        <article class="card border-1 shadow-sm h-100 team_card">
                                            <a t-attf-href="#{team.website_url}" class="text-reset text-decoration-none h-100 d-flex flex-column">
                                                <img src="/website_helpdesk/static/src/img/team_image.jpg" alt="Imagen"/>
                                                <main class="card-body d-flex flex-column">
                                                    <h2 t-attf-class="fw-bold my-3">
                                                        <span t-field="team.name" itemprop="name"/>
                                                    </h2>
                                                    <div class="navbar-brand fw-bold text-primary text-uppercase h5 me-auto w-100">
                                                        Contáctenos <i class="oi oi-arrow-right"/>
                                                    </div>
                                                </main>
                                            </a>
                                        </article>
                                    </div>
                                </div>
                            </t>
                        </t>

                        <!-- Sin equipos disponibles -->
                        <t t-else="">
                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="alert alert-info" role="alert">
                                        <t t-if="is_public">
                                            Inicie sesión para ver los equipos de su empresa.
                                        </t>
                                        <t t-else="">
                                            No hay equipos publicados para las <t t-esc="user_companies_count"/> compañías a las que tiene acceso. Contacte al administrador.
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>

                    </div>
                </div>
            </t>
        </template>

        <!-- =================================================================
             TEMPLATE 2: /helpdesk/mc/<team_id> — Formulario de ticket
             ================================================================= -->
        <template id="helpdesk_ticket_form_page" name="Mesa de Ayuda — Crear Ticket">
            <t t-call="website.layout">
                <t t-set="additional_title">Crear Solicitud — <t t-esc="team.name"/></t>

                <div id="wrap" class="oe_structure">
                    <div class="container mt-4 mb-4">
                        <div class="row">
                            <div class="col-lg-8 offset-lg-2">

                                <div class="mb-3">
                                    <a href="/helpdesk/teams" class="btn btn-secondary btn-sm">Volver</a>
                                </div>

                                <div class="card">
                                    <div class="card-header">
                                        <h3 class="mb-0"><t t-esc="team.name"/></h3>
                                        <small class="text-muted"><t t-esc="team.company_id.name"/></small>
                                    </div>

                                    <div class="card-body">
                                        <!-- Mensaje de éxito -->
                                        <t t-if="success">
                                            <div class="alert alert-success" role="alert">
                                                <strong>¡Solicitud enviada correctamente!</strong><br/>
                                                Recibirá un correo de confirmación con los detalles de su solicitud. Nuestro equipo le contactará a la brevedad.
                                            </div>
                                            <a href="/helpdesk/teams" class="btn btn-primary">Volver a Mesa de Ayuda</a>
                                        </t>

                                        <!-- Formulario de creación -->
                                        <t t-else="">
                                            <t t-if="error and error.get('_global')">
                                                <div class="alert alert-danger" role="alert">
                                                    <t t-esc="error['_global']"/>
                                                </div>
                                            </t>

                                            <form t-attf-action="/helpdesk/mc/#{team.id}/submit" method="POST">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                                <!-- Nombre del solicitante -->
                                                <div class="mb-3">
                                                    <label for="partner_name" class="form-label">Nombre completo *</label>
                                                    <input type="text" id="partner_name" name="partner_name"
                                                           t-attf-class="form-control #{'is-invalid' if error and error.get('partner_name') else ''}"
                                                           t-att-value="default_values.get('partner_name', '')" required="required"/>
                                                    <t t-if="error and error.get('partner_name')">
                                                        <div class="invalid-feedback"><t t-esc="error['partner_name']"/></div>
                                                    </t>
                                                </div>

                                                <!-- Correo electrónico -->
                                                <div class="mb-3">
                                                    <label for="partner_email" class="form-label">Correo electrónico *</label>
                                                    <input type="email" id="partner_email" name="partner_email"
                                                           t-attf-class="form-control #{'is-invalid' if error and error.get('partner_email') else ''}"
                                                           t-att-value="default_values.get('partner_email', '')" required="required"/>
                                                    <t t-if="error and error.get('partner_email')">
                                                        <div class="invalid-feedback"><t t-esc="error['partner_email']"/></div>
                                                    </t>
                                                </div>

                                                <!-- Asunto del ticket -->
                                                <div class="mb-3">
                                                    <label for="name" class="form-label">Asunto *</label>
                                                    <input type="text" id="name" name="name"
                                                           t-attf-class="form-control #{'is-invalid' if error and error.get('name') else ''}"
                                                           t-att-value="default_values.get('name', '')" required="required"/>
                                                    <t t-if="error and error.get('name')">
                                                        <div class="invalid-feedback"><t t-esc="error['name']"/></div>
                                                    </t>
                                                </div>

                                                <!-- Tipo de ticket -->
                                                <t t-if="ticket_types">
                                                    <div class="mb-3">
                                                        <label for="ticket_type_id" class="form-label">Tipo de solicitud</label>
                                                        <select id="ticket_type_id" name="ticket_type_id" class="form-select">
                                                            <option value="">— Seleccionar tipo —</option>
                                                            <t t-foreach="ticket_types" t-as="ttype">
                                                                <option t-att-value="ttype.id" t-att-selected="'selected' if default_values.get('ticket_type_id') == str(ttype.id) else None">
                                                                    <t t-esc="ttype.name"/>
                                                                </option>
                                                            </t>
                                                        </select>
                                                    </div>
                                                </t>

                                                <!-- Descripción -->
                                                <div class="mb-3">
                                                    <label for="description" class="form-label">Descripción detallada</label>
                                                    <textarea id="description" name="description" class="form-control" rows="5"><t t-esc="default_values.get('description', '')"/></textarea>
                                                </div>

                                                <button type="submit" class="btn btn-primary">Enviar Solicitud</button>
                                                <a href="/helpdesk/teams" class="btn btn-link">Cancelar</a>
                                            </form>
                                        </t>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
