<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =================================================================
             HELPDESK TEAM — Form View: sección "Portal Multicompañía"
             ================================================================= -->
        <record id="helpdesk_team_view_form_inherit_mc"
                model="ir.ui.view">
            <field name="name">helpdesk.team.form.inherit.mc</field>
            <field name="model">helpdesk.team</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <separator string="Portal Multicompañía"/>
                    <group>
                        <group>
                            <field name="is_published_on_portal"
                                   widget="boolean_toggle"/>
                            <field name="website_icon"
                                   invisible="not is_published_on_portal"/>
                        </group>
                        <group>
                            <field name="website_description"
                                   placeholder="Descripción para la tarjeta del portal. Vacío = texto automático."
                                   invisible="not is_published_on_portal"/>
                        </group>
                    </group>
                    <div class="alert alert-info mb-0" role="alert"
                         invisible="not is_published_on_portal">
                        <i class="fa fa-info-circle me-2"/>
                        Este equipo aparecerá en
                        <strong>/helpdesk/teams</strong>. El formulario de
                        tickets se abrirá en
                        <strong>/helpdesk/mc/<t t-esc="id"/></strong>,
                        ruta propia del módulo que funciona desde
                        <strong>cualquier sitio web</strong> sin errores 404.
                    </div>
                </xpath>
            </field>
        </record>

        <!-- =================================================================
             HELPDESK TEAM — List View: columna opcional "Portal MC"
             ================================================================= -->
        <record id="helpdesk_team_view_list_inherit_mc"
                model="ir.ui.view">
            <field name="name">helpdesk.team.list.inherit.mc</field>
            <field name="model">helpdesk.team</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_team_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="is_published_on_portal"
                           string="Portal MC"
                           optional="hide"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
