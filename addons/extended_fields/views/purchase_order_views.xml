<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inh" model="ir.ui.view">
        <field name="name">purchase.order.form.inh</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="pgm_operation_type"/>
                <field name="pgm_purchase_type"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="pgm_vendor_delivery_address"/>
            </xpath>
            <xpath expr="//page[@name='purchase_delivery_invoice']//group" position="inside">
                <group string="CONTACT REGISTRY">
                    <field name="pgm_fiscal_registry"/>
                    <field name="pgm_consecutive_number"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_inh_req_domain" model="ir.ui.view">
        <field name="name">purchase.order.form.inh</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_requisition.purchase_order_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='requisition_id']" position="attributes">
                <attribute name="domain">[('state', '=', 'confirmed'), ('vendor_id', 'in', (partner_id, False)), ('company_id', '=', company_id), ('is_contract_expired', '=', False)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
