<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_add_desc_fecha_after_is_storable" model="ir.ui.view">
      <field name="name">product.template.form.add.desc.fecha.after.is_storable</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_form_view"/>
      <field name="arch" type="xml">
        <!-- Insertar DESPUÉS del div que contiene is_storable/tracking -->
        <xpath expr="//label[@for='is_storable']/following-sibling::div[contains(@class,'o_row')][1]" position="after">
            <field name="pgm_description"/>
            <field name="pgm_creation_request_date"/>
            <field name="pgm_material_type" invisible="type != 'consu'"/>
        </xpath>
      </field>
    </record>
</odoo>
