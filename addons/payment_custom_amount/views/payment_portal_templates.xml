<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
        ═══════════════════════════════════════════════════════════════════
        PORTAL: Pestañas de selección de monto (Total/Parcial/Personalizado)
        Odoo 18: el xpath apunta al form[@name="o_payment_checkout"] o al
        primer elemento del bloque de pago visible en payment.pay
        ═══════════════════════════════════════════════════════════════════
        -->
        <template id="payment_pay_custom_amount_tabs"
                  inherit_id="payment.pay"
                  name="Custom Amount Tabs">

            <!--
                En Odoo 18, el template payment.pay contiene una sección con
                id="o_payment_form" o un <form> con name="o_payment_checkout".
                Inyectamos nuestras pestañas ANTES del bloque principal usando
                el div wrapper con id="o_payment_form" o como fallback "."
            -->
            <xpath expr="//div[@id='o_payment_form']" position="before">
                <t t-if="allow_custom_amount">

                    <div class="o_payment_amount_tabs mb-4"
                         id="payment_amount_selector">

                        <!-- Barra de pestañas -->
                        <ul class="nav nav-tabs"
                            id="paymentAmountTabs"
                            role="tablist">

                            <!-- Pestaña 1: Total -->
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active"
                                        id="tab-full-btn"
                                        data-bs-toggle="tab"
                                        data-bs-target="#tab-full"
                                        type="button"
                                        role="tab"
                                        aria-controls="tab-full"
                                        aria-selected="true"
                                        data-payment-type="full"
                                        data-amount-value="">
                                    <i class="fa fa-check-circle me-1 text-success"/>
                                    Pago Total
                                </button>
                            </li>

                            <!-- Pestaña 2: Parcial (solo si hay monto parcial distinto al total) -->
                            <t t-if="payment_partial_amount
                                     and payment_partial_amount > 0
                                     and payment_partial_amount != amount">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link"
                                            id="tab-partial-btn"
                                            data-bs-toggle="tab"
                                            data-bs-target="#tab-partial"
                                            type="button"
                                            role="tab"
                                            aria-controls="tab-partial"
                                            aria-selected="false"
                                            data-payment-type="partial"
                                            t-att-data-amount-value="payment_partial_amount">
                                        <i class="fa fa-adjust me-1 text-warning"/>
                                        Pago Parcial
                                    </button>
                                </li>
                            </t>

                            <!-- Pestaña 3: Monto personalizado -->
                            <li class="nav-item" role="presentation">
                                <button class="nav-link"
                                        id="tab-custom-btn"
                                        data-bs-toggle="tab"
                                        data-bs-target="#tab-custom"
                                        type="button"
                                        role="tab"
                                        aria-controls="tab-custom"
                                        aria-selected="false"
                                        data-payment-type="custom"
                                        data-amount-value="0">
                                    <i class="fa fa-pencil me-1 text-primary"/>
                                    Otro Monto
                                </button>
                            </li>

                        </ul>

                        <!-- Contenido de las pestañas -->
                        <div class="tab-content border border-top-0 rounded-bottom p-3 bg-white"
                             id="paymentAmountTabsContent">

                            <!-- Contenido: Total -->
                            <div class="tab-pane fade show active"
                                 id="tab-full" role="tabpanel"
                                 aria-labelledby="tab-full-btn">
                                <div class="d-flex align-items-center justify-content-between py-2">
                                    <div>
                                        <p class="mb-1 fw-semibold">Monto total a pagar</p>
                                        <p class="text-muted small mb-0">Cancela el saldo completo.</p>
                                    </div>
                                    <div class="text-end">
                                        <span class="fs-4 fw-bold text-success o_payment_full_amount">
                                            <t t-esc="amount"/>
                                        </span>
                                        <span class="ms-1 text-muted small">
                                            <t t-esc="currency.name"/>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Contenido: Parcial -->
                            <t t-if="payment_partial_amount
                                     and payment_partial_amount > 0
                                     and payment_partial_amount != amount">
                                <div class="tab-pane fade"
                                     id="tab-partial" role="tabpanel"
                                     aria-labelledby="tab-partial-btn">
                                    <div class="d-flex align-items-center justify-content-between py-2">
                                        <div>
                                            <p class="mb-1 fw-semibold">Monto parcial pactado</p>
                                            <p class="text-muted small mb-0">Paga la cuota o abono acordado.</p>
                                        </div>
                                        <div class="text-end">
                                            <span class="fs-4 fw-bold text-warning">
                                                <t t-esc="payment_partial_amount"/>
                                            </span>
                                            <span class="ms-1 text-muted small">
                                                <t t-esc="currency.name"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- Contenido: Personalizado -->
                            <div class="tab-pane fade"
                                 id="tab-custom" role="tabpanel"
                                 aria-labelledby="tab-custom-btn">
                                <div class="py-2">
                                    <p class="mb-2 fw-semibold">Ingresa el monto que deseas pagar</p>
                                    <div class="input-group input-group-lg mb-2">
                                        <span class="input-group-text">
                                            <t t-esc="currency.symbol or currency.name"/>
                                        </span>
                                        <input type="number"
                                               id="custom_payment_amount_input"
                                               class="form-control o_custom_amount_input"
                                               placeholder="0.00"
                                               step="0.01"
                                               t-att-min="custom_min_amount"
                                               t-att-max="amount"
                                               t-att-data-min="custom_min_amount"
                                               