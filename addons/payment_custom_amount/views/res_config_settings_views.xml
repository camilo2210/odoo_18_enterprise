<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_res_config_settings_payment_custom" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.payment.custom.amount</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="priority" eval="15"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Payment Link"
                         string="Payment Link"
                         name="payment_custom_amount"
                         groups="account.group_account_manager">
                        <block title="Monto Personalizado en Payment Link"
                               name="payment_custom_amount_block">
                            <setting string="Monto minimo pago personalizado (COP)"
                                     help="Monto minimo global para la pestana Otro Monto. Minimo absoluto: 1,500 COP (Mercado Pago Colombia)."
                                     id="payment_custom_min_amount_setting">
                                <field name="payment_custom_min_amount"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>