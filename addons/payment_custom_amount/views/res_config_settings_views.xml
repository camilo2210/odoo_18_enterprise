<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_res_config_settings_payment_custom" model="ir.ui.view">
            <field name="name">res.config.settings.payment.custom.amount</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='sale_quotation_order']" position="after">
                    <div id="payment_link_custom_amount" class="col-12 col-lg-6">
                        <h2>Payment Link</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-xs-12 col-md-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="payment_custom_min_amount"
                                           string="Monto minimo pago personalizado"/>
                                    <div class="text-muted">
                                        Monto minimo global en COP que el cliente puede
                                        ingresar en la pestana "Otro Monto" del payment link.
                                        Minimo absoluto: 1,500 COP (Mercado Pago Colombia).
                                    </div>
                                    <div class="content-group mt8">
                                        <div class="row">
                                            <field name="payment_custom_min_amount"
                                                   class="col-lg-7"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>