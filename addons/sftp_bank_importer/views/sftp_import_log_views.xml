<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── LIST VIEW ───────────────────────────────────────────────── -->
    <record id="view_sftp_import_log_list" model="ir.ui.view">
        <field name="name">sftp.import.log.list</field>
        <field name="model">sftp.import.log</field>
        <field name="arch" type="xml">
            <list string="Import Logs"
                  decoration-success="state == 'success'"
                  decoration-danger="state == 'error'"
                  decoration-warning="state == 'skipped'"
                  default_order="create_date desc">
                <field name="import_date" string="Date"/>
                <field name="config_id" string="Configuration"/>
                <field name="filename"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'skipped'"/>
                <field name="lines_imported"/>
                <field name="statement_id" optional="show"/>
                <field name="message" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── FORM VIEW ───────────────────────────────────────────────── -->
    <record id="view_sftp_import_log_form" model="ir.ui.view">
        <field name="name">sftp.import.log.form</field>
        <field name="model">sftp.import.log</field>
        <field name="arch" type="xml">
            <form string="Import Log Entry" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="filename"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'success'"
                                   decoration-danger="state == 'error'"
                                   decoration-warning="state == 'skipped'"/>
                            <field name="lines_imported"/>
                        </group>
                        <group>
                            <field name="import_date"/>
                            <field name="statement_id"/>
                        </group>
                    </group>
                    <group string="Detail Message">
                        <field name="message" nolabel="1" readonly="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── SEARCH VIEW ─────────────────────────────────────────────── -->
    <record id="view_sftp_import_log_search" model="ir.ui.view">
        <field name="name">sftp.import.log.search</field>
        <field name="model">sftp.import.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="filename"/>
                <field name="config_id"/>
                <filter string="Success" name="success" domain="[('state','=','success')]"/>
                <filter string="Errors" name="errors" domain="[('state','=','error')]"/>
                <filter string="Skipped" name="skipped" domain="[('state','=','skipped')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('import_date','&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Configuration" name="group_config"
                            context="{'group_by': 'config_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date"
                            context="{'group_by': 'import_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── WINDOW ACTION ───────────────────────────────────────────── -->
    <record id="action_sftp_import_log" model="ir.actions.act_window">
        <field name="name">Import Logs</field>
        <field name="res_model">sftp.import.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_errors': 1}</field>
    </record>

</odoo>